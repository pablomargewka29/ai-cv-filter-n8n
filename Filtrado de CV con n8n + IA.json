        "subject": "=Candidato a evaluar  {{ $json.nombre }}",
        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; border: 1px solid #e0e0e0; border-radius: 8px;\">\n  \n  <div style=\"background-color: #1a3a5c; padding: 20px; border-radius: 6px 6px 0 0;\">\n    <h1 style=\"color: white; margin: 0; font-size: 20px;\">📄 Reporte de Evaluación de CV</h1>\n  </div>\n  <div style=\"padding: 20px; background-color: #f9f9f9;\">\n    \n    <p><strong>Candidato:</strong> {{ $('Code in JavaScript').item.json.nombre }}</p>\n    <p><strong>Fecha:</strong> {{ $('Code in JavaScript').item.json.fecha }}</p>\n    <hr style=\"border: none; border-top: 1px solid #e0e0e0; margin: 20px 0;\">\n    <h2 style=\"color: #1a3a5c; font-size: 16px;\">🎯 Puntaje</h2>\n    <p style=\"font-size: 28px; font-weight: bold; color: #1a3a5c;\">{{ $('Code in JavaScript').item.json.puntaje_display }}</p>\n    <h2 style=\"color: #1a3a5c; font-size: 16px;\">🏆 Decisión</h2>\n    <p style=\"font-size: 18px; font-weight: bold; color: green;\">{{ $('Code in JavaScript').item.json.decision }}</p>\n    <hr style=\"border: none; border-top: 1px solid #e0e0e0; margin: 20px 0;\">\n    <h2 style=\"color: #1a3a5c; font-size: 16px;\">✅ Puntos Fuertes</h2>\n    <p>{{ $('Code in JavaScript').item.json.puntos_fuertes }}</p>\n    <h2 style=\"color: #1a3a5c; font-size: 16px;\">❌ Puntos Débiles</h2>\n    <p>{{ $('Code in JavaScript').item.json.puntos_debiles }}</p>\n    <h2 style=\"color: #1a3a5c; font-size: 16px;\">💬 Conclusión</h2>\n    <p>{{ $('Code in JavaScript').item.json.conclusion }}</p>\n  </div>\n  <div style=\"background-color: #1a3a5c; padding: 12px 20px; border-radius: 0 0 6px 6px;\">\n    <p style=\"color: white; margin: 0; font-size: 12px;\">Generado automáticamente por el sistema de filtrado de CVs</p>\n  </div>\n</div>",
