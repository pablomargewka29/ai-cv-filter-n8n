    {
      "parameters": {
        "jsCode": "const raw = $input.item.json.output;\nconst cleaned = raw.replace(/```json|```/g, '').trim();\nconst data = JSON.parse(cleaned);\nreturn { json: {\n  fecha: new Date().toLocaleDateString('es-AR'),\n  nombre: data.nombre,\n  decision: data.decision,\n  puntaje: data.puntaje,           // número solo para el IF\n  puntaje_display: data.puntaje + '/10',  // para mostrar en el mail\n  puntos_fuertes: data.puntos_fuertes.join(' | '),\n  puntos_debiles: data.puntos_debiles.join(' | '),\n  conclusion: data.recomendacion\n}};"
      },
